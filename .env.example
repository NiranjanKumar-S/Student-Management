# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (Defaults to local SQLite students.db if unset)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/student_db
DATABASE_URL=sqlite:///students.db

# Server Port
PORT=5000
